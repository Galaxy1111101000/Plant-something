{
  "expo": {
    "name": "Plant App",
    "slug": "plant-app",
    "version": "1.0.0",
    "scheme": "plantapp",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.plantapp.native"
    },
    "android": {
      "package": "com.plantapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store"
    ]
  },
  "plugins": [
    "expo-secure-store"
  ]
}
